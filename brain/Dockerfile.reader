# Magpie AI reader: websites (Crawl4AI over HTTP, no browser) and files (Docling, no OCR). Build context: brain/.
FROM python:3.12.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DOCLING_MODELS=/opt/docling-models CRAWL4AI_NO_CLOUD_NOTICE=1 \
    OMP_NUM_THREADS=2 PORT=8810
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-reader.txt ./
RUN pip install --no-cache-dir -r requirements-reader.txt
# Only the layout and table models: no OCR, no picture or formula models.
RUN python -c "from pathlib import Path; from docling.utils.model_downloader import download_models; download_models(output_dir=Path('/opt/docling-models'), with_layout=True, with_tableformer=True, with_code_formula=False, with_picture_classifier=False, with_rapidocr=False)" \
    && chmod -R a+rX /opt/docling-models
ENV HF_HUB_OFFLINE=1
COPY magpie_reader ./magpie_reader
RUN useradd --create-home --uid 10002 reader
USER reader
EXPOSE 8810
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8810/healthz', timeout=4)"
CMD ["python", "-m", "magpie_reader.main"]
